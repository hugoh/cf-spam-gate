amends "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Config.pkl"
import "package://github.com/hugoh/hk-config/releases/download/v1.4.0/hk-config@1.4.0#/base.pkl" as Base

min_hk_version = Base.min_hk_version

local linters = new Mapping<String, Step> {
    ...Base.base
    // data/model.json is a generated build artifact (see scripts/train-model.mjs),
    // not hand-edited — exempt it from the formatting-oriented base checks.
    ["check_added_large_files"] = (Base.base["check_added_large_files"]) {
        exclude = List("data/model.json")
    }
    ["newlines"] = (Base.base["newlines"]) {
        exclude = List("data/model.json")
    }
    // Misspellings in the training corpus's vocabulary are the classifier's
    // actual content (spam text is full of them) — not real typos to fix.
    ["typos"] = (Base.base["typos"]) {
        exclude = List("data/model.json")
    }
    // Run via bun (the project's own typescript devDependency) rather than
    // Builtins.tsc's mise-managed global tsc — one fewer place to keep the
    // TypeScript version in sync.
    ["tsc"] = {
        glob = List("**/*.ts")
        check = "bun run typecheck"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["commit-msg"] {
        steps = Base.commit_msg
    }
    ["pre-push"] {
        steps = linters
    }
    ["check"] {
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
}
